        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"__NAMESPACE__\", pod=~\"__SERVICE__-.*\", container=\"app\"}[5m]))",
          "legendFormat": "{{pod}}",
